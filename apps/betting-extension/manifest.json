{
  "manifest_version": 3,
  "name": "Evobo — Aposta automática",
  "version": "0.10.0",
  "description": "Aposta automática do Evobo na Betano e na Bet365: liga/desliga e testa aqui; modo, teto, logins e histórico ficam no Evobo (Aposta automática)",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "*://*.betano.bet.br/*",
    "*://*.bet365.bet.br/*",
    "https://evobo-api.fly.dev/*",
    "https://evobo.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.betano.bet.br/*"
      ],
      "js": [
        "betano/plan.js",
        "betano/slip.js",
        "betano/login.js",
        "betano/run.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.bet365.bet.br/*"
      ],
      "js": [
        "betano/plan.js",
        "bet365/slip.js",
        "bet365/login.js",
        "bet365/run.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Evobo — Aposta automática"
  },
  "background": {
    "service_worker": "background.js"
  }
}
