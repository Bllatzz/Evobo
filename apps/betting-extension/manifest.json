{
  "manifest_version": 3,
  "name": "Evobo Betano",
  "version": "0.4.0",
  "description": "Lê as tips da Betano do Evobo, loga se precisar, abre o link, confere a odd e preenche a stake; só aposta com \"Apostar de verdade\" ligado",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "*://*.betano.bet.br/*",
    "https://evobo-api.fly.dev/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.betano.bet.br/*"
      ],
      "js": [
        "betano/plan.js",
        "betano/slip.js",
        "betano/login.js",
        "betano/run.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Evobo Betano"
  },
  "background": {
    "service_worker": "background.js"
  }
}
