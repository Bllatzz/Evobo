# Personal Telegram account (MTProto, via GramJS) — NOT the same session as
# any other Telegram automation (e.g. robotip's). Get api_id/api_hash from
# https://my.telegram.org. TELEGRAM_SESSION starts empty: the first `npm run
# dev` run does an interactive login and writes the session string back into
# this file automatically.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Same local Postgres (via Supabase) apps/api uses — port 54322 is
# `supabase start`'s default local Postgres port.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Same local Redis apps/api's queues use.
REDIS_URL="redis://localhost:6379"

# Same local Supabase project apps/api uses (Storage for bet-slip photos).
SUPABASE_URL="http://localhost:54321"
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio key — used for bet-slip odd OCR (Gemini Vision).
GEMINI_API_KEY=

# OCR_PROVIDER=ollama switches bet-slip OCR from Gemini to a local vision
# model via Ollama (http://localhost:11434 by default) — no API cost/quota,
# lower accuracy on fine print. OCR_PROVIDER=openai switches to OpenAI vision
# instead (needs OPENAI_API_KEY). Leave unset (or "gemini") to use Gemini.
# OCR_PROVIDER=ollama
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_VISION_MODEL="qwen2.5vl:7b"

# Senha do túnel do PC (ngrok → localTunnelProxy). Definir o MESMO valor no
# worker do Fly (secret) e no .env do PC onde o proxy roda — worker primeiro,
# proxy depois. Sem ela, o proxy só aplica a allowlist de paths.
# TUNNEL_SECRET=

# OCR_PROVIDER=openai switches bet-slip OCR to OpenAI vision (ver
# openaiVision.ts) — pago por uso, sem cota grátis do Gemini.
# OCR_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL="gpt-4o-mini"

# Token da "vitrine pública" do canal no Tippy — a parte depois de `?t=` em
# https://app.tippybot.com.br/publico/?t=<token>. Lido por tippy/config.ts
# pra graduar as tips do Padovan NBA/NFL (fetch puro, sem custo). Sem ele o
# grupo é só pulado. Em produção: `fly secrets set TIPPY_TOKEN_PADOVAN_NBA_NFL=...`.
# TIPPY_TOKEN_PADOVAN_NBA_NFL=
