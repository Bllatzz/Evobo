# Env do "npm run ocr-worker" (src/ocrWorker.ts) — roda SÓ o consumidor da
# fila de OCR (extract-details), no seu PC, apontando pro Redis/banco/
# Supabase de PRODUÇÃO (não os locais de .env). Ele compete com o worker do
# Fly pela mesma fila: enquanto este processo está de pé, parte dos prints
# é processada aqui com Ollama em vez de Gemini.
#
# Copie pra .env.ocr-worker (git-ignored) e preencha com os valores reais de
# produção. Pra pegar os valores:
#   fly redis status evobo-redis          -> REDIS_URL (campo "Private URL")
#   fly ssh console -a evobo-api -C "printenv" -> DATABASE_URL, DIRECT_URL,
#                                                  SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# NUNCA comite .env.ocr-worker com valores reais.

REDIS_URL="redis://default:<password>@fly-evobo-redis.upstash.io:6379"
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OCR_PROVIDER=ollama
OLLAMA_URL="http://localhost:11434"
OLLAMA_VISION_MODEL="qwen2.5vl:7b"
