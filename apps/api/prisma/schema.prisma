// Schema owns table/enum/index migrations via `prisma migrate`. RLS policies
// are NOT expressed here (Prisma can't model them) — they live as raw SQL
// appended to the generated migration files. See apps/api/supabase/ for the
// local Postgres+Auth+Storage runtime (via `supabase start`), which this
// schema's DATABASE_URL points at; Supabase's own migration CLI is not used
// so there is a single source of truth for schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String             @unique
  description  String?
  isSystem     Boolean            @default(false) @map("is_system")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  users        User[]
  screenAccess RoleScreenAccess[]

  @@map("roles")
}

/// screenKey is validated against @evobo/shared-types' ScreenKey enum at the
/// application layer, not a DB enum — the set of screens changes more often
/// than we want to run a migration for.
model RoleScreenAccess {
  roleId    String     @map("role_id") @db.Uuid
  screenKey String     @map("screen_key")
  tier      ScreenTier @default(free)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, screenKey])
  @@map("role_screen_access")
}

/// "vip" rows only count toward a user's accessibleScreens if they hold an
/// active VipSubscription to any group — see GET /me. Default "free" keeps
/// every pre-existing row (and every other role) behaving exactly as before.
enum ScreenTier {
  free
  vip

  @@map("screen_tier")
}

/// id == auth.users.id (Supabase Auth owns credentials/sessions; this is the
/// public profile row). No default — the id is assigned by Auth on
/// signup via a DB trigger, not by Prisma.
model User {
  id                  String    @id @db.Uuid
  username            String    @unique
  displayName         String    @map("display_name")
  avatarUrl           String?   @map("avatar_url")
  bio                 String?
  favoriteSports      String[]  @default([]) @map("favorite_sports")
  roleId              String    @map("role_id") @db.Uuid
  role                Role      @relation(fields: [roleId], references: [id])
  verifiedAt          DateTime? @map("verified_at")
  verifiedBadgeReason String?   @map("verified_badge_reason")
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tips             Tip[]
  vipGroupsOwned   VipGroup[]
  vipSubscriptions VipSubscription[]
  payments         Payment[]      @relation("PaymentUser")
  paymentsReviewed Payment[]      @relation("PaymentReviewer")
  followers        Follow[]       @relation("Followed")
  following        Follow[]       @relation("Follower")
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  tipTakes         TipTake[]
  telegramBancaSettings    TelegramBancaSettings?
  telegramBookmakerBalances TelegramBookmakerBalance[]
  telegramTipTakes         TelegramTipTake[]
  favorites                UserFavorite[]
  bookmakerCredentials     BookmakerCredential[]
  extensionKey             ExtensionKey?
  autoBetSettings          AutoBetSettings?
  autoBetRuns              AutoBetRun[]

  @@map("users")
}

enum GameStatus {
  scheduled
  live
  finished

  @@map("game_status")
}

model Game {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId String?    @unique @map("external_id")
  homeTeam   String     @map("home_team")
  awayTeam   String     @map("away_team")
  league     String
  startsAt   DateTime   @map("starts_at")
  status     GameStatus @default(scheduled)
  scoreHome  Int?       @map("score_home")
  scoreAway  Int?       @map("score_away")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tips Tip[]

  @@index([startsAt, status])
  @@map("games")
}

enum TipStatus {
  pending
  green
  red
  void

  @@map("tip_status")
}

enum TipVisibility {
  public
  vip_only

  @@map("tip_visibility")
}

enum TipConfidence {
  baixa
  media
  alta

  @@map("tip_confidence")
}

model Tip {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId        String        @map("author_id") @db.Uuid
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  matchId         String        @map("match_id") @db.Uuid
  match           Game          @relation(fields: [matchId], references: [id], onDelete: Restrict)
  market          String
  odds            Decimal       @db.Decimal(6, 2)
  stakeUnits      Decimal       @map("stake_units") @db.Decimal(4, 1)
  house           String
  confidence      TipConfidence?
  analysisText    String?       @map("analysis_text")
  imageUrl        String?       @map("image_url")
  status          TipStatus     @default(pending)
  resultSettledAt DateTime?     @map("result_settled_at")
  visibility      TipVisibility @default(public)
  vipGroupId      String?       @map("vip_group_id") @db.Uuid
  vipGroup        VipGroup?     @relation(fields: [vipGroupId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  comments Comment[]
  takes    TipTake[]

  @@index([authorId])
  @@index([matchId])
  @@index([status])
  @@map("tips")
}

/// "Peguei" — a viewer marking they took a tip. Not in the originally
/// approved schema; added because the Feed/Tip aberta "Peguei" button and
/// Meu Perfil's "Minhas apostas" tab both require it and there was no other
/// table to back them.
model TipTake {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipId     String   @map("tip_id") @db.Uuid
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tipId, userId])
  @@index([userId])
  @@map("tip_takes")
}

enum BillingPeriod {
  monthly
  quarterly
  yearly

  @@map("billing_period")
}

model VipGroup {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String        @map("owner_id") @db.Uuid
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("BRL")
  billingPeriod BillingPeriod @map("billing_period")
  createdAt     DateTime      @default(now()) @map("created_at")

  tips          Tip[]
  subscriptions VipSubscription[]
  payments      Payment[]

  @@map("vip_groups")
}

enum VipSubscriptionStatus {
  active
  expired
  canceled

  @@map("vip_subscription_status")
}

model VipSubscription {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vipGroupId String                 @map("vip_group_id") @db.Uuid
  vipGroup   VipGroup               @relation(fields: [vipGroupId], references: [id], onDelete: Cascade)
  status     VipSubscriptionStatus  @default(active)
  startedAt  DateTime               @default(now()) @map("started_at")
  expiresAt  DateTime               @map("expires_at")

  payments Payment[]

  @@index([userId, status])
  @@map("vip_subscriptions")
}

enum PaymentMethod {
  pix_manual

  @@map("payment_method")
}

/// Manual Pix reconciliation, no PSP: awaiting_proof (QR generated, waiting
/// on the user) -> pending_review (proof uploaded, waiting on an admin) ->
/// approved | rejected. vip_subscription_id is null until approval, since
/// the subscription doesn't exist yet at awaiting_proof/pending_review.
model Payment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  user              User             @relation("PaymentUser", fields: [userId], references: [id], onDelete: Restrict)
  vipGroupId        String           @map("vip_group_id") @db.Uuid
  vipGroup          VipGroup         @relation(fields: [vipGroupId], references: [id], onDelete: Restrict)
  vipSubscriptionId String?          @map("vip_subscription_id") @db.Uuid
  vipSubscription   VipSubscription? @relation(fields: [vipSubscriptionId], references: [id], onDelete: SetNull)
  billingPeriod     BillingPeriod    @map("billing_period")
  amount            Decimal          @db.Decimal(10, 2)
  currency          String           @default("BRL")
  method            PaymentMethod    @default(pix_manual)
  qrCodePayload     String           @map("qr_code_payload")
  proofImageUrl     String?          @map("proof_image_url")
  status            PaymentStatus    @default(awaiting_proof)
  reviewedBy        String?          @map("reviewed_by") @db.Uuid
  reviewer          User?            @relation("PaymentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?        @map("reviewed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@map("payments")
}

enum PaymentStatus {
  awaiting_proof
  pending_review
  approved
  rejected

  @@map("payment_status")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followedId String   @map("followed_id") @db.Uuid
  followed   User     @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([followerId, followedId])
  @@index([followerId])
  @@index([followedId])
  @@map("follows")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipId     String   @map("tip_id") @db.Uuid
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

/// UNUSED — robot-signals/routes.ts now proxies robotip's live alerts API
/// (ROBOTIP_API_URL) directly instead of reading a local snapshot; a CSV
/// import here turned out to always be stale (pinned to whatever "result"
/// rows had at export time). Kept only so migration history isn't rewritten;
/// safe to drop this model/table/migration in a follow-up.
model RobotSignal {
  id                   Int       @id
  botName              String?   @map("bot_name")
  odds                 Decimal?  @db.Decimal(6, 2)
  homeTeam             String?   @map("home_team")
  awayTeam             String?   @map("away_team")
  robotipUrl           String?   @map("robotip_url")
  gameMinute           Int?      @map("game_minute")
  homeOdds             Decimal?  @map("home_odds") @db.Decimal(6, 2)
  drawOdds             Decimal?  @map("draw_odds") @db.Decimal(6, 2)
  awayOdds             Decimal?  @map("away_odds") @db.Decimal(6, 2)
  competition          String?
  scoreHome            Int?      @map("score_home")
  scoreAway            Int?      @map("score_away")
  lastGoalMinute       Int?      @map("last_goal_minute")
  cornersHome          Int?      @map("corners_home")
  cornersAway          Int?      @map("corners_away")
  lastCornerMinute     Int?      @map("last_corner_minute")
  goalsOverOdds        Decimal?  @map("goals_over_odds") @db.Decimal(6, 2)
  stakePct             Decimal?  @map("stake_pct") @db.Decimal(5, 1)
  dangerousHome        Int?      @map("dangerous_home")
  dangerousAway        Int?      @map("dangerous_away")
  dangerousPerMin5     String?   @map("dangerous_per_min_5")
  dangerousPerMinTotal String?   @map("dangerous_per_min_total")
  yellowHome           Int?      @map("yellow_home")
  yellowAway           Int?      @map("yellow_away")
  redHome              Int?      @map("red_home")
  redAway              Int?      @map("red_away")
  shotsSideHome        Int?      @map("shots_side_home")
  shotsSideAway        Int?      @map("shots_side_away")
  shotsTargetHome      Int?      @map("shots_target_home")
  shotsTargetAway      Int?      @map("shots_target_away")
  possessionHome       Decimal?  @map("possession_home") @db.Decimal(5, 1)
  possessionAway       Decimal?  @map("possession_away") @db.Decimal(5, 1)
  pi1                  Decimal?  @db.Decimal(6, 2)
  pi2                  Decimal?  @db.Decimal(6, 2)
  receivedAt           DateTime  @map("received_at")
  result               String    @default("pending")
  rawMessage           String?   @map("raw_message")

  @@map("robot_signals")
}

/// Per-market "odd indicada" (apps/web/src/app/admin/AdminPage.tsx) —
/// admin-editable. When a market's groupKey (see marketNormalizer.ts) has a
/// row here, "Histórico do Robô" shows an extra "Lucro com odd indicada"
/// stat on that market's detail page: total profit if every green op had
/// been bet at this odd instead of its own real recorded odd (the real
/// green/red result stays real, only the odd changes — same idea as
/// robotip's "Simulador de odd fixa"). The main "Lucro" figure always uses
/// each operation's real recorded odd, unaffected by this table.
model RobotMarketOdd {
  groupKey     String   @id @map("group_key")
  indicatedOdd Decimal  @db.Decimal(6, 3) @map("indicated_odd")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("robot_market_odds")
}

/// Personal tip tracker fed by a Telegram MTProto listener (apps/worker) —
/// separate account/system from robot-signals' proxy to robotip. "Telegram"
/// prefix on all 3 models is intentional: avoids colliding with the
/// unrelated `Tip`/`VipGroup` models (public tipster feed / paid VIP
/// groups), which mean something completely different. RLS is enabled with
/// zero policies (see the migration's raw SQL) — same "backend-only access"
/// convention as vip_subscriptions; Prisma connects as `postgres` and
/// ignores RLS regardless, this is defense in depth only.
model TelegramGroup {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  telegramChatId String    @unique @map("telegram_chat_id")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  tips TelegramTip[]

  @@map("telegram_groups")
}

/// One row per selection (a multi-selection message, e.g. 3 separate stake
/// lines, becomes N rows sharing the same telegramMessageId/photoPath; a
/// combo/"múltipla" bet across several markets stays 1 row with `selection`
/// listing all legs). Tips land here directly as soon as the worker parses
/// the message — no separate approval queue. Result comes from a manual
/// dashboard edit for now (auto-fetching the bookmaker's settled result is
/// future work, not built yet).
///
/// Storage cost control: apps/worker's purgeOldTips runs daily and, for
/// RESOLVED tips (result != pending) older than 60 days, deletes the Storage
/// photo and nulls match/selection/betUrl/rawMessage/parsePattern — keeping
/// exactly the columns GET /banca aggregates (groupId, bookmaker, unit, odd,
/// result, takenStatus, receivedAt) so historical metrics never change, only
/// the per-tip detail disappears. Pending tips are never purged, regardless
/// of age — losing the photo before it's reviewed would make it unresolvable.
model TelegramTip {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId           String   @map("group_id") @db.Uuid
  telegramMessageId BigInt   @map("telegram_message_id")
  match             String?
  selection         String?
  /// Categoria do mercado (Resultado 1X2, Over/Under Gols, Handicap, Ambas
  /// Marcam, Escanteios, Cartões, Resultado 1º/2º Tempo, Combinada, Outro) —
  /// classificada pela OCR (apps/worker/src/ocrShared.ts's MARKET_TYPE_CATEGORIES),
  /// separado do texto livre em `selection`. Null até a OCR rodar (ou pra
  /// tips sem foto/já completas por texto, que nunca chamam a OCR).
  marketType        String?  @map("market_type")
  unit              Decimal? @db.Decimal(5, 2)
  odd               Decimal? @db.Decimal(6, 2)
  /// "ocr" (Gemini Vision) | "manual" | "text" (already explicit in the
  /// Telegram message body, e.g. "ODD: 2.80") — null until one of them sets it.
  oddSource         String?  @map("odd_source")
  /// The last odd that came from the source (text/photo) — kept in sync with
  /// `odd` whenever oddSource is "text"/"ocr", untouched by a manual edit, so
  /// the dashboard can flag "a odd mudou desde a mensagem" (a drop/move) by
  /// comparing this against the current `odd`.
  originalOdd       Decimal? @map("original_odd") @db.Decimal(6, 2)
  bookmaker         String?
  betUrl            String?  @map("bet_url")
  /// Set instead of bookmaker/betUrl when the tip can be placed at more than
  /// one house (e.g. "🔗 Betfair · 🔗 Betnacional") — same bet, not N tips.
  /// Shape: {bookmaker: string | null, betUrl: string | null}[]. The
  /// dashboard shows a select; picking one PATCHes bookmaker/betUrl above.
  bookmakerOptions  Json?    @map("bookmaker_options")
  photoPath         String?  @map("photo_path")
  /// pending | green | red | reembolso — official grading, admin-only
  /// (see AdminTelegramTipsPage), independent of any user's own take.
  result            String   @default("pending")
  /// "Limite de aposta: R$ X" from the message text, when the house capped
  /// how much could actually be staked — used by the bet-analytix
  /// auto-grader to explain a stake that comes in under `unit` (a capped
  /// bet, not a red flag), never to disqualify a match.
  limit             Decimal? @db.Decimal(10, 2)
  /// True when the daily bet-analytix auto-grader found ambiguous
  /// candidates for this tip (disagreeing matches, or nothing confident)
  /// and left `result` alone — cleared the moment `result` is set, auto or
  /// manual. Surfaced as "precisa revisar" on AdminTelegramTipsPage.
  needsReview       Boolean  @default(false) @map("needs_review")
  /// Which parser matcher recognized the message (see apps/worker/src/parseTip.ts's
  /// KNOWN_PATTERNS) — null means nothing matched and every extractable field
  /// still needs a manual look on the dashboard.
  parsePattern      String?  @map("parse_pattern")
  receivedAt        DateTime @default(now()) @map("received_at")
  rawMessage        String?  @map("raw_message")

  group TelegramGroup    @relation(fields: [groupId], references: [id])
  takes TelegramTipTake[]

  @@index([telegramMessageId])
  @@index([groupId])
  @@map("telegram_tips")
}

/// Per-user personal tracking for one TelegramTip: whether they took it,
/// and — if so — what unit/odd/casa they personally used (may differ from
/// the tip's own official unit/odd/bookmaker, e.g. a smaller stake or a
/// different house). One row per (tip, user), created lazily on first
/// PATCH /telegram-tips/:id/take. Split out of TelegramTip itself so two
/// people tracking the same tip never overwrite each other.
model TelegramTipTake {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipId  String @map("tip_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// "pending" (never explicitly set — the true default) | "taken" | "skipped".
  takenStatus String   @default("pending") @map("taken_status")
  unit        Decimal? @db.Decimal(5, 2)
  odd         Decimal? @db.Decimal(6, 2)
  bookmaker   String?
  betUrl      String?  @map("bet_url")
  /// Bônus/turbinada em R$ pago por fora da odd (ex.: "Aposta Turbinada
  /// +50%" da Betano, calculado sobre o lucro, não sobre a odd) — nunca
  /// entra no casamento odd-a-odd do import, só soma no lucro em R$
  /// (aggregateBy em routes.ts) quando existe unitValue pra converter.
  bonusReais Decimal? @db.Decimal(8, 2) @map("bonus_reais")
  /// True quando `unit` acima foi ajustado pra baixo porque a unidade pedida,
  /// convertida em reais pelo unitValue da Banca deste usuário, passava do
  /// `limit` (R$) da TelegramTip — ver PATCH /:id/take.
  limitApplied Boolean @default(false) @map("limit_applied")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tip  TelegramTip @relation(fields: [tipId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@unique([tipId, userId])
  @@index([userId])
  @@map("telegram_tip_takes")
}

/// Per-user bankroll settings for the Banca Telegram report — value of 1
/// unit in R$, used to convert the unit-based profit/ROI into currency.
model TelegramBancaSettings {
  userId    String   @id @map("user_id") @db.Uuid
  unitValue Decimal? @map("unit_value") @db.Decimal(10, 2)
  /// Admin-assigned `{ [bookmakerSlug]: "#rrggbb" }` map, shown as a small
  /// color dot next to each bookmaker in the report's "Por casa de aposta"
  /// table — set from Admin rather than derived automatically.
  bookmakerColors Json?    @map("bookmaker_colors")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("telegram_banca_settings")
}

/// How much money the user has parked in each bookmaker — purely informational,
/// entered manually on the profile page for bankroll management.
model TelegramBookmakerBalance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookmaker String
  balance   Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, bookmaker])
  @@map("telegram_bookmaker_balances")
}

enum FavoriteKind {
  team
  league

  @@map("favorite_kind")
}

/// Teams/leagues a user starred on the Jogos page. `externalId` is robotip's
/// own id (home_id/away_id or id_liga from the jogosdodia feed) — the name
/// and image are snapshotted so the favorites list renders without having to
/// find that team/league in some day's feed first.
model UserFavorite {
  userId     String       @map("user_id") @db.Uuid
  kind       FavoriteKind
  externalId String       @map("external_id")
  name       String
  imageUrl   String?      @map("image_url")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, externalId])
  @@map("user_favorites")
}

/// Bookmaker login for "Aposta automática" (admin-only for now). Username and
/// password are AES-256-GCM encrypted with CREDENTIALS_ENCRYPTION_KEY (a Fly
/// secret, never in the DB) — reversible on purpose: the betting extension
/// has to type the real password into the bookmaker's login form. The API
/// only ever hands them out decrypted to the owner's extension key.
model BookmakerCredential {
  userId       String   @map("user_id") @db.Uuid
  bookmaker    String
  usernameEnc  String   @map("username_enc")
  passwordEnc  String   @map("password_enc")
  /// Masked username ("b****@hotmail.com") so the profile can show which
  /// account is connected without decrypting anything.
  usernameHint String   @map("username_hint")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, bookmaker])
  @@map("bookmaker_credentials")
}

/// The betting extension's credential — one per user, generated from the
/// profile and shown once. Only its SHA-256 is stored (the API just checks
/// it, never needs it back). Replaces a Supabase session because the
/// extension runs unattended and the account signs in with Google.
model ExtensionKey {
  userId     String    @id @map("user_id") @db.Uuid
  keyHash    String    @unique @map("key_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("extension_keys")
}

/// "Aposta automática" configurada no Evobo: liga/desliga, modo e teto. O
/// valor da unidade fica em TelegramBancaSettings.unitValue.
model AutoBetSettings {
  userId        String    @id @map("user_id") @db.Uuid
  enabled       Boolean   @default(false)
  placeReal     Boolean   @default(false) @map("place_real")
  maxStakeReais Decimal   @default(50) @map("max_stake_reais") @db.Decimal(10, 2)
  /// Última vez que foi ligado — só tips recebidas depois disso entram na fila.
  enabledSince  DateTime? @map("enabled_since")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auto_bet_settings")
}

/// O que a extensão fez com cada tip (ou teste manual) — o histórico do perfil.
model AutoBetRun {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookmaker String
  /// `${groupId}:${telegramMessageId}` da fila, ou "manual:<ms>".
  taskKey   String   @map("task_key")
  betUrl    String?  @map("bet_url")
  title     String?
  /// apostou | conferiu | pulou | abortou | verificar | erro
  status    String
  summary   String
  dryRun    Boolean  @map("dry_run")
  report    Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "auto_bet_runs_user_created_idx")
  @@index([userId, taskKey], map: "auto_bet_runs_user_task_idx")
  @@map("auto_bet_runs")
}
